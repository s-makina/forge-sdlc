# ============================================================
# ForgeSDLC environment configuration (example — no secrets)
# Copy to .env and fill in real values. Never commit .env.
# ============================================================

# --- Postgres ---
POSTGRES_USER=forgesdlc
POSTGRES_PASSWORD=forgesdlc
POSTGRES_DB=forgesdlc
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- Dashboard (Next.js) ---
DASHBOARD_PORT=3000
# Base URL the dashboard uses to reach the API
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# --- Reverse proxy (nginx) ---
PROXY_PORT=80

# --- API (FastAPI) ---
API_PORT=8000
ENVIRONMENT=development
# Full SQLAlchemy connection string for the API
DATABASE_URL=postgresql+psycopg://forgesdlc:forgesdlc@postgres:5432/forgesdlc
REDIS_URL=redis://redis:6379/0

# --- Security ---
# Long random value in production; used to sign session cookies.
SESSION_SECRET_KEY=change-me-in-production
SESSION_COOKIE_NAME=forgesdlc_session

# --- Bootstrap operator ---
BOOTSTRAP_OPERATOR_EMAIL=operator@forgesdlc.local
BOOTSTRAP_OPERATOR_PASSWORD=change-me

# --- Temporal ---
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8080

# --- Ollama (Phase 2 placeholder) ---
OLLAMA_PORT=11434