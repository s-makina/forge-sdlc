# ============================================================
# ForgeSDLC environment configuration (example — no secrets)
# Copy to .env and fill in real values. Never commit .env.
# ============================================================

# --- Postgres ---
POSTGRES_USER=forgesdlc
POSTGRES_PASSWORD=forgesdlc
POSTGRES_DB=forgesdlc
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- Dashboard (Next.js) ---
DASHBOARD_PORT=3000
# Base URL the browser uses to reach the API. Behind the nginx proxy, use the
# relative path "/api/v1" so requests are same-origin (no CORS). For local
# `pnpm dev` outside Docker, use the absolute URL http://localhost:8000/api/v1.
NEXT_PUBLIC_API_BASE_URL=/api/v1
# Internal URL the dashboard's server-side rendering uses to reach the API
# over the Docker network. Keep the default unless you rename the service.
API_INTERNAL_BASE_URL=http://api:8000/api/v1

# --- Reverse proxy (nginx) ---
PROXY_PORT=80

# --- API (FastAPI) ---
API_PORT=8000
ENVIRONMENT=development
# Full SQLAlchemy connection string for the API
DATABASE_URL=postgresql+psycopg://forgesdlc:forgesdlc@postgres:5432/forgesdlc
REDIS_URL=redis://redis:6379/0

# --- Security ---
# Long random value in production; used to sign session cookies.
SESSION_SECRET_KEY=change-me-in-production
SESSION_COOKIE_NAME=forgesdlc_session

# --- Bootstrap operator ---
BOOTSTRAP_OPERATOR_EMAIL=operator@forgesdlc.local
BOOTSTRAP_OPERATOR_PASSWORD=change-me

# --- Temporal ---
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8080

# --- Ollama (Phase 2 placeholder) ---
# Local model runtime. DISABLED by default — see docker-compose.yml.
# The platform uses external OpenAI-compatible endpoints via LiteLLM instead.
OLLAMA_PORT=11434

# --- Model gateway (LiteLLM) ---
LITELLM_PORT=4000
LITELLM_MASTER_KEY=sk-litellm-local
# Where the API writes the config generated from the model registry.
# Mounted from ./infrastructure/litellm; LiteLLM reads it at startup.
LITELLM_CONFIG_PATH=/app/gateway/config.yaml

# --- External OpenAI-compatible provider (Phase 2) ---
# Default base URL is NVIDIA NIM's OpenAI-compatible endpoint.
# Set EXTERNAL_MODEL_API_KEY to your API key (read at call time, never stored).
EXTERNAL_MODEL_BASE_URL=https://integrate.api.nvidia.com/v1
EXTERNAL_MODEL_API_KEY=

# --- Execution manager (Phase 3) ---
EXECUTION_MANAGER_PORT=8001
