{
  "name": "forgesdlc",
  "version": "0.1.0",
  "private": true,
  "description": "Autonomous SDLC platform",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "build": "pnpm --filter dashboard build",
    "lint": "pnpm --filter dashboard lint",
    "typecheck": "pnpm --filter dashboard typecheck",
    "test": "pnpm --filter dashboard test",
    "format": "prettier --write \"**/*.{ts,tsx,json,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,yaml,yml}\""
  },
  "devDependencies": {
    "prettier": "^3.3.3"
  }
}
